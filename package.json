{
  "name": "dahsha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dahsha: documentaries in Arabic and English.",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/product.js dahsha dev",
    "build": "node scripts/product.js dahsha build",
    "start": "node scripts/product.js dahsha start",
    "rebuild-catalog": "node server/src/cli.js build",
    "refresh-data": "node server/src/cli.js refresh",
    "poll-data": "node server/src/cli.js poll",
    "export": "node scripts/product.js dahsha export",
    "build:static": "node scripts/product.js dahsha build",
    "publish": "npx --yes netlify-cli@27.12.0 deploy --prod --no-build --dir client/dist --site 2b4ce6d4-a0b4-487b-a142-5875429bbd83",
    "snapshot:save": "node scripts/snapshot.js save",
    "snapshot:restore": "node scripts/snapshot.js restore",
    "check:regression": "node scripts/check-regression.js",
    "dev:dahsha": "node scripts/product.js dahsha dev",
    "start:dahsha": "node scripts/product.js dahsha start",
    "export:dahsha": "node scripts/product.js dahsha export",
    "build:dahsha": "node scripts/product.js dahsha build",
    "test": "node --test server/test/*.test.js",
    "refresh:providers": "node scripts/refresh-providers.js --product dahsha",
    "refresh:providers:full": "node scripts/refresh-providers.js --product dahsha --full",
    "build:mobile": "node scripts/product.js dahsha mobile-web"
  }
}
