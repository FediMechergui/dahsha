{
  "name": "dahsha-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Dahsha Android app",
  "scripts": {
    "build:web": "node ../scripts/product.js dahsha mobile-web",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "icons": "node ../scripts/icons.js && node ../scripts/android-icons.js",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "sharp": "^0.33.5"
  }
}
